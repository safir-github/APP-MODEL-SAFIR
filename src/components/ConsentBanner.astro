---
// Bannière de consentement à la mesure d'audience. Refuser et accepter ont le même poids visuel.
// Tant qu'aucun choix n'est fait, rien n'est mesuré. Voir docs/ANALYTICS.md.
---
<div id="consent-banner" class="consent-banner" hidden>
  <p class="text-sm mb-3">Mesure d’audience : nous aimerions compter les pages visitées, sans identifier personne. Vous pouvez refuser sans conséquence.</p>
  <div class="flex gap-2">
    <button type="button" data-consent="refuse" class="consent-btn flex-1">Refuser</button>
    <button type="button" data-consent="accept" class="consent-btn flex-1">Accepter</button>
  </div>
</div>

<style>
  .consent-banner {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 96px;
    z-index: 60;
    padding: 14px 16px;
    border-radius: 22px;
  }
</style>

<script>
  import { initConsent } from '../scripts/consent';
  initConsent();
</script>
