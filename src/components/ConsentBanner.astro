---
// Bannière de consentement à la mesure d'audience. Refuser et accepter ont le même poids visuel.
// Tant qu'aucun choix n'est fait, rien n'est mesuré. Voir docs/ANALYTICS.md.
// raised : true quand la barre d'onglets est affichée, pour que la bannière reste au-dessus.
// Elle est positionnée dans l'écran du cadre (slot overlay), jamais au-dessus de la barre.
const { raised = false } = Astro.props;
---
<div id="consent-banner" class:list={["consent-banner", { "consent-banner--raised": raised }]} hidden>
  <p class="text-sm mb-3">Mesure d’audience : nous aimerions compter les pages visitées, sans identifier personne. Vous pouvez refuser sans conséquence.</p>
  <div class="flex gap-2">
    <button type="button" data-consent="refuse" class="consent-btn flex-1">Refuser</button>
    <button type="button" data-consent="accept" class="consent-btn flex-1">Accepter</button>
  </div>
</div>

<style>
  .consent-banner {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 20px;
    z-index: 60;
    padding: 14px 16px;
    border-radius: 22px;
  }
  /* Au-dessus de la barre d'onglets (hauteur 68 px + marge de 22 px) */
  .consent-banner--raised {
    bottom: 100px;
  }
</style>

<script>
  import { initConsent } from '../scripts/consent';
  initConsent();
</script>
