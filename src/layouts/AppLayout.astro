---
import '../styles/global.css';
const { title = 'Mon app' } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e1318" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem('app-theme') || 'dark';
    </script>
  </head>
  <body class="min-h-screen">
    <div class="max-w-md mx-auto px-5 pt-8 pb-40">
      <slot />
    </div>
  </body>
</html>
