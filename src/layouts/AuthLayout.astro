---
import '../styles/global.css';
import AuthTools from '../components/AuthTools.astro';
import DeviceFrame from '../components/DeviceFrame.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
const { title = 'Connexion' } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e1318" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem('app-theme') || 'dark';
    </script>
  </head>
  <body class="min-h-screen flex flex-col items-center justify-center">
    <DeviceFrame center>
      <AuthTools />
      <main class="w-full max-w-sm p-6">
        <slot />
      </main>
      <div slot="overlay"><ConsentBanner /></div>
    </DeviceFrame>
    <script>
      import '../scripts/auth-tools.ts';
    </script>
  </body>
</html>
