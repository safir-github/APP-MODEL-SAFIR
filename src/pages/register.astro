---
import AuthLayout from '../layouts/AuthLayout.astro';
---
<AuthLayout title="Créer un compte">
  <h1 class="font-serif text-3xl font-semibold mb-6" style="font-family: var(--serif)">Créer un compte</h1>
  <div id="error-msg" hidden class="mb-4 rounded-xl px-4 py-3 text-sm" style="color: var(--neg)"></div>
  <form id="auth-form" class="space-y-4">
    <label class="block text-sm">
      <span class="block mb-1.5" style="color: var(--text-2)">Adresse e-mail</span>
      <input type="email" name="email" required autocomplete="email" class="w-full h-12 rounded-2xl px-4 bg-transparent border" style="border-color: var(--line-2)" />
    </label>
    <label class="block text-sm">
      <span class="block mb-1.5" style="color: var(--text-2)">Mot de passe</span>
      <div class="relative"><input id="password-input" type="password" name="password" required autocomplete="new-password" minlength="8" class="w-full h-12 rounded-2xl pl-4 pr-12 bg-transparent border" style="border-color: var(--line-2)" /><button type="button" data-toggle-password="password-input" aria-label="Afficher le mot de passe" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 inline-flex items-center justify-center" style="color: var(--text-2)"><svg data-eye="open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg><svg data-eye="closed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9.88 9.88 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg></button></div>
    </label>
    <button id="submit-btn" type="submit" class="w-full h-12 rounded-3xl font-semibold" style="background: var(--copper); color: var(--on-accent)">
      Créer mon compte
    </button>
    <span id="spinner" hidden></span>
  </form>
  <p class="mt-6 text-sm text-center" style="color: var(--text-2)">
    Déjà inscrit ? <a href="/login" style="color: var(--copper)">Se connecter</a>
  </p>
  <p class="mt-4 text-xs text-center" style="color: var(--text-2)">
    En créant un compte, vous acceptez les <a href="/conditions" style="color: var(--copper)">conditions d'utilisation</a> et la <a href="/confidentialite" style="color: var(--copper)">politique de confidentialité</a>.
  </p>
</AuthLayout>

<script>
  import '../scripts/auth-form.ts';
</script>
