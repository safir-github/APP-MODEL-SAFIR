---
import AuthLayout from '../layouts/AuthLayout.astro';
---
<AuthLayout title="Nouveau mot de passe">
  <h1 class="font-serif text-3xl font-semibold mb-6" style="font-family: var(--serif)">Nouveau mot de passe</h1>
  <div id="error-msg" hidden class="mb-4 rounded-xl px-4 py-3 text-sm" style="color: var(--neg)"></div>
  <div id="done-msg" hidden class="mb-4 rounded-xl px-4 py-3 text-sm" style="color: var(--text-2)">
    Votre mot de passe a été changé. <a href="/login" style="color: var(--copper)">Se connecter</a>
  </div>
  <form id="reset-form" class="space-y-4">
    <label class="block text-sm">
      <span class="block mb-1.5" style="color: var(--text-2)">Nouveau mot de passe (8 caractères minimum)</span>
      <div class="relative"><input id="password-field" type="password" name="password" required minlength="8" autocomplete="new-password" class="w-full h-12 rounded-2xl pl-4 pr-12 bg-transparent border" style="border-color: var(--line-2)" /><button type="button" data-toggle-password="password-field" aria-label="Afficher le mot de passe" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 inline-flex items-center justify-center" style="color: var(--text-2)"><svg data-eye="open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg><svg data-eye="closed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9.88 9.88 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg></button></div>
    </label>
    <label class="block text-sm">
      <span class="block mb-1.5" style="color: var(--text-2)">Confirmer le mot de passe</span>
      <div class="relative"><input id="confirm-field" type="password" name="confirm" required minlength="8" autocomplete="new-password" class="w-full h-12 rounded-2xl pl-4 pr-12 bg-transparent border" style="border-color: var(--line-2)" /><button type="button" data-toggle-password="confirm-field" aria-label="Afficher le mot de passe" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 inline-flex items-center justify-center" style="color: var(--text-2)"><svg data-eye="open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg><svg data-eye="closed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9.88 9.88 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg></button></div>
    </label>
    <button id="submit-btn" type="submit" class="w-full h-12 rounded-3xl font-semibold" style="background: var(--copper); color: var(--on-accent)">
      Enregistrer
    </button>
  </form>
</AuthLayout>

<script>
  import { api } from '../scripts/api';

  const form = document.getElementById('reset-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorEl = document.getElementById('error-msg') as HTMLElement;
  const doneEl = document.getElementById('done-msg') as HTMLElement;

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    const fd = new FormData(form);
    const password = String(fd.get('password') || '');
    const confirm = String(fd.get('confirm') || '');
    if (password !== confirm) {
      showError('Les deux mots de passe ne correspondent pas.');
      return;
    }
    // Le jeton vient du lien reçu par e-mail (paramètre ?token=)
    const token = new URLSearchParams(window.location.search).get('token') || '';
    if (!token) {
      showError('Ce lien de réinitialisation est invalide ou a expiré.');
      return;
    }
    submitBtn.disabled = true;
    const { ok, data } = await api.reset(token, password);
    submitBtn.disabled = false;
    if (!ok) {
      showError(data?.error || 'Une erreur est survenue. Réessayez.');
      return;
    }
    form.hidden = true;
    doneEl.hidden = false;
  });
</script>
